@model JobNestMVC.Models.CompanyProfeil
@{
    ViewBag.Title = "CompanyProfile_PageLoad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .profile-page {
        min-height: 80vh;
        padding: 50px 20px;
        background: linear-gradient(135deg, #f5f7fb, #e8f0ff);
    }

    .profile-container {
        max-width: 850px;
        margin: auto;
        background: white;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.10);
    }

    .profile-header {
        text-align: center;
        margin-bottom: 35px;
    }

        .profile-header h2 {
            font-size: 34px;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 8px;
        }

        .profile-header p {
            color: #6b7280;
            font-size: 15px;
        }

    .profile-form {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px 25px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

        .form-group.full {
            grid-column: span 2;
        }

        .form-group label {
            font-weight: 600;
            color: #374151;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .form-group input[type="text"],
        .form-group textarea {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #d1d5db;
            border-radius: 9px;
            font-size: 15px;
            box-sizing: border-box;
            outline: none;
            transition: 0.3s;
        }

            .form-group input[type="text"]:focus,
            .form-group textarea:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 3px rgba(37,99,235,0.10);
            }

        .form-group textarea {
            min-height: 120px;
            resize: vertical;
        }

    .logo-section {
        grid-column: span 2;
        text-align: center;
        padding: 20px;
        background: #f8fafc;
        border-radius: 14px;
    }

        .logo-section label {
            display: block;
            font-weight: 600;
            color: #374151;
            margin-bottom: 15px;
        }

    .company-logo {
        width: 150px;
        height: 150px;
        object-fit: contain;
        border-radius: 15px;
        border: 1px solid #e5e7eb;
        padding: 8px;
        background: white;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    }

    .button-section {
        grid-column: span 2;
        text-align: center;
        margin-top: 10px;
    }

    .update-button {
        background: #2563eb;
        color: white;
        border: none;
        padding: 12px 35px;
        border-radius: 9px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
    }

        .update-button:hover {
            background: #1d4ed8;
            transform: translateY(-2px);
        }

    .message {
        display: block;
        margin-top: 15px;
        color: #16a34a;
        font-weight: 600;
    }

    @@media (max-width: 700px) {
        .profile-container {
            padding: 25px;
        }

        .profile-form {
            grid-template-columns: 1fr;
        }

        .form-group.full,
        .logo-section,
        .button-section {
            grid-column: span 1;
        }
    }
</style>

<div class="profile-page">

    ```
    <div class="profile-container">

        <div class="profile-header">
            <h2>Company Profile</h2>
            <p>Manage your company information and profile details</p>
        </div>

        <div>
            @using (Html.BeginForm("CompanyProfile_PageLoad", "CompanyProfile", FormMethod.Get))
            {
                <div class="profile-form">

                    <div class="form-group">
                        <label>Name:</label>
                        @Html.TextBoxFor(m => m.name)
                    </div>

                    <div class="form-group">
                        <label>Email:</label>
                        @Html.TextBoxFor(m => m.email)
                    </div>

                    <div class="form-group">
                        <label>Phone:</label>
                        @Html.TextBoxFor(m => m.phone)
                    </div>

                    <div class="form-group">
                        <label>Location:</label>
                        @Html.TextBoxFor(m => m.location)
                    </div>

                    <div class="form-group full">
                        <label>Description:</label>
                        @Html.TextAreaFor(m => m.description)
                    </div>

                    <div class="logo-section">
                        <label>Company Logo</label>

                        <img src="@Url.Content(Model.logo)"
                             alt="Company Logo"
                             class="company-logo" />
                    </div>

                    <div class="button-section">
                        <input type="submit"
                               value="Update"
                               class="update-button" />

                        <span class="message">
                            @Html.DisplayFor(m => m.msg)
                        </span>
                    </div>

                </div>
            }
        </div>

    </div>
    ```

</div>

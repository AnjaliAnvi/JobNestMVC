@model JobNestMVC.Models.AdminInsert
@{
    ViewBag.Title = "InsertCompany_PageLoad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .company-container {
        width: 650px;
        margin: 40px auto;
        background: #ffffff;
        padding: 35px 45px;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.12);
    }

        .company-container h2 {
            text-align: center;
            margin-bottom: 30px;
            color: #2c3e50;
            font-size: 28px;
        }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            font-weight: 600;
            color: #34495e;
        }

    .form-control {
        width: 100%;
        padding: 11px 12px;
        border: 1px solid #d5d8dc;
        border-radius: 6px;
        box-sizing: border-box;
        font-size: 14px;
        outline: none;
    }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 4px rgba(52,152,219,0.25);
        }

    textarea.form-control {
        height: 100px;
        resize: vertical;
    }

    .validation {
        color: #e74c3c;
        font-size: 13px;
    }

    .submit-area {
        text-align: center;
        margin-top: 25px;
    }

    .insert-btn {
        background: #3498db;
        color: white;
        border: none;
        padding: 11px 35px;
        border-radius: 6px;
        font-size: 15px;
        cursor: pointer;
    }

        .insert-btn:hover {
            background: #2980b9;
        }

    .message {
        display: block;
        margin-top: 12px;
        color: #27ae60;
        text-align: center;
    }
</style>

<div class="company-container">

    <h2>Company Registration</h2>

    <div>
        @using (Html.BeginForm("InsertCompany_Click", "InsertCompany", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {

            <div class="form-group">
                <label>Name:</label>
                @Html.TextBoxFor(m => m.name, new { @class = "form-control", placeholder = "Enter company name" })
                @Html.ValidationMessageFor(m => m.name, "", new { @class = "validation" })
            </div>

            <div class="form-group">
                <label>Email:</label>
                @Html.TextBoxFor(m => m.email, new { @class = "form-control", placeholder = "Enter company email" })
                @Html.ValidationMessageFor(m => m.email, "", new { @class = "validation" })
            </div>

            <div class="form-group">
                <label>Phone:</label>
                @Html.TextBoxFor(m => m.phone, new { @class = "form-control", placeholder = "Enter phone number" })
                @Html.ValidationMessageFor(m => m.phone, "", new { @class = "validation" })
            </div>

            <div class="form-group">
                <label>Location:</label>
                @Html.TextBoxFor(m => m.location, new { @class = "form-control", placeholder = "Enter company location" })
                @Html.ValidationMessageFor(m => m.location, "", new { @class = "validation" })
            </div>

            <div class="form-group">
                <label>Description:</label>
                @Html.TextAreaFor(m => m.description, new { @class = "form-control", placeholder = "Enter company description" })
                @Html.ValidationMessageFor(m => m.description, "", new { @class = "validation" })
            </div>

            <div class="form-group">
                <label>Logo:</label>
                @Html.TextBox("file", "", new { Type = "file", @class = "form-control" })
            </div>

            <div class="form-group">
                <label>Username:</label>
                @Html.TextBoxFor(m => m.username, new { @class = "form-control", placeholder = "Enter username" })
                @Html.ValidationMessageFor(m => m.username, "", new { @class = "validation" })
            </div>

            <div class="form-group">
                <label>Password:</label>
                @Html.PasswordFor(m => m.password, new { @class = "form-control", placeholder = "Enter password" })
            </div>

            <div class="form-group">
                <label>Confirm Password:</label>
                @Html.PasswordFor(m => m.cpassword, new { @class = "form-control", placeholder = "Confirm password" })
                @Html.ValidationMessageFor(m => m.cpassword, "", new { @class = "validation" })
            </div>

            <div class="submit-area">
                <input type="submit" value="Insert Company" class="insert-btn" />
                @Html.DisplayFor(m => m.cmsg, new { @class = "message" })
            </div>
        }
    </div>
</div>
@model JobNestMVC.Models.JobApplication

@{ ViewBag.Title = "Apply Job";
                Layout = "~/Views/Shared/UserLayout.cshtml"; }

<div class="application-container">

    <div class="application-card">

        <h2>Job Application</h2>

        <p>Please enter your details to apply for this job.</p>

        @using (Html.BeginForm(
    "ApplyJob",
    "JobDescription",
    FormMethod.Post,
    new { enctype = "multipart/form-data" }))
        {
    <input type="hidden" name="job_id" value="@ViewBag.JobId" />

                    <div class="form-group">

                        <label>Name</label>

                        @Html.TextBoxFor(
                                      x => x.name,
                                      new
                                      {
                                          @class = "form-control",
                                          placeholder = "Enter your name"
                                      })

                    </div>


                                    <div class="form-group">

                                        <label>Experience</label>

                                        @Html.TextBoxFor(
                                                      x => x.experience,
                                                      new
                                                      {
                                                          @class = "form-control",
                                                          placeholder = "Enter your experience"
                                                      })

                                    </div>


                                                    <div class="form-group">

                                                        <label>Location</label>

                                                        @Html.TextBoxFor(
                                                                      x => x.location,
                                                                      new
                                                                      {
                                                                          @class = "form-control",
                                                                          placeholder = "Enter your location"
                                                                      })

                                                    </div>


                                                                    <div class="form-group">

                                                                        <label>Skills</label>

                                                                        @Html.TextAreaFor(
                                                                                      x => x.skills,
                                                                                      new
                                                                                      {
                                                                                          @class = "form-control",
                                                                                          placeholder = "Enter your skills",
                                                                                          rows = "4"
                                                                                      })

                                                                    </div>


                                                                                    <div class="form-group">

                                                                                        <label>Resume</label>

                                                                                        <input type="file"
                                                                                               name="resumeFile"
                                                                                               class="form-control" />

                                                                                    </div>


                                                                                                    <button type="submit"
                                                                                                            class="apply-btn">

                                                                                                        Apply

                                                                                                    </button>}

    </div>

</div>


<style>

    .application-container {
        width: 90%;
        max-width: 700px;
        margin: 40px auto;
    }

    .application-card {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.10);
    }

        .application-card h2 {
            color: #172b4d;
            margin-bottom: 10px;
        }

    .form-group {
        margin-top: 20px;
    }

        .form-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
        }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        box-sizing: border-box;
    }

    .apply-btn {
        margin-top: 25px;
        padding: 14px 35px;
        background: #1976d2;
        color: white;
        border: none;
        border-radius: 7px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
    }

        .apply-btn:hover {
            background: #125ca8;
        }
</style>
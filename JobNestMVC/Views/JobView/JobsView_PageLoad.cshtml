```cshtml
@{
    ViewBag.Title = "JobsView_PageLoad";
    Layout = "~/Views/Shared/UserLayout.cshtml";
}


<div class="container">

    <!-- =========================
         SEARCH SECTION
         ========================= -->
    <div class="job-search">

        <div class="search-heading">
            <h1>Find Your Dream Job</h1>
            <p>Discover the right opportunity for your career</p>
        </div>

        @using (Html.BeginForm("searchjobclick", "JobView", FormMethod.Get))
        {
    <div class="search-row">

        @Html.TextBox("JobTitle", null, new
        {
            @class = "search-input",
            placeholder = "Job Title or Keywords"
        })

        @Html.TextBox("Location", null, new
        {
            @class = "search-input",
            placeholder = "Location"
        })

        @Html.TextBox("Experience", null, new
        {
            @class = "search-input",
            placeholder = "Experience"
        })

        @Html.TextBox("Company", null, new
        {
            @class = "search-input",
            placeholder = "Company"
        })

        @*<input type="submit"
        value="Search"
        class="search-btn" />*@
        <input type="submit"
               value="Search"
               class="search-btn" />

        <a href="@Url.Action("JobsView_PageLoad", "JobView")"
           class="search-btn">
            View All Jobs
        </a>

    </div>
        }

    </div>


    <!-- =========================
         JOB SECTION
         ========================= -->
    <div class="job-section">

        <div class="section-heading">

            <div>
                <h2>Available Jobs</h2>
                <p>Explore the latest job opportunities</p>
            </div>

        </div>


        <!-- JOB GRID -->
        <div class="job-grid">

            @foreach (var item in ViewBag.userdetails)
            {
                <div class="job-card">

                    <!-- =========================
                         COMPANY LOGO + NAME
                         ========================= -->
                    <div class="company-section">

                        <!-- COMPANY LOGO -->
                        <div class="company-logo-box">

                            <img src="@Url.Content(@item.logo)"
                                 class="company-logo"
                                 alt="Company Logo" />

                        </div>


                        <!-- COMPANY NAME -->
                        <div class="company-info">

                            <span class="company-label">
                                COMPANY
                            </span>

                            <h3 class="company-name">
                                @item.Company
                            </h3>

                        </div>

                    </div>


                    <!-- =========================
                         JOB TITLE + LOCATION
                         ========================= -->
                    <div class="job-header">

                        <div class="job-title-section">

                            <h2>
                                @item.job_title
                            </h2>

                        </div>

                        <div class="job-location">
                            📍 @item.location
                        </div>

                    </div>


                    <!-- =========================
                         JOB DETAILS
                         ========================= -->
                    <div class="job-details">

                        <div class="detail-item">

                            <span class="detail-icon">
                                💼
                            </span>

                            <div>

                                <small>
                                    Experience
                                </small>

                                <strong>
                                    @item.experience
                                </strong>

                            </div>

                        </div>


                        <div class="detail-item">

                            <span class="detail-icon">
                                💰
                            </span>

                            <div>

                                <small>
                                    Salary
                                </small>

                                <strong>
                                    @item.salary
                                </strong>

                            </div>

                        </div>

                    </div>


                    <!-- =========================
                         FOOTER
                         ========================= -->
                    <div class="job-footer">

                        <div class="date-info">

                            <div>

                                <small>
                                    Posted On
                                </small>

                                <span>
                                    @item.posted_date
                                </span>

                            </div>


                            <div>

                                <small>
                                    Closing Date
                                </small>

                                <span class="closing">
                                    @item.last_date
                                </span>

                            </div>

                        </div>


                        @*<button class="apply-btn">
            Apply Now →
        </button>*@

                    <a href="@Url.Action("JobDescription_PageLoad", "JobDescription", new { id = item.job_id })"
                       class="apply-btn">
                        View Job →
                    </a>

                    </div>

                </div>
            }

        </div>

    </div>

</div>


<style>

    /* =========================
       GENERAL
       ========================= */

    * {
        box-sizing: border-box;
    }

    .container {
        width: 92%;
        max-width: 1200px;
        margin: 35px auto;
        font-family: Arial, sans-serif;
    }


    /* =========================
       SEARCH SECTION
       ========================= */

    .job-search {
        background: linear-gradient(135deg, #eef5ff, #f8fbff);
        padding: 35px;
        border-radius: 15px;
        margin-bottom: 40px;
        border: 1px solid #dce8f7;
    }


    .search-heading {
        text-align: center;
        margin-bottom: 28px;
    }


        .search-heading h1 {
            margin: 0;
            color: #12365a;
            font-size: 32px;
            font-weight: 700;
        }


        .search-heading p {
            margin-top: 8px;
            color: #68798c;
            font-size: 15px;
        }


    /* =========================
       SEARCH INPUTS
       ========================= */

    .search-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }


    .search-input {
        height: 48px;
        padding: 0 15px;
        border: 1px solid #ccd7e3;
        border-radius: 7px;
        flex: 1;
        min-width: 170px;
        background: white;
        font-size: 14px;
        outline: none;
    }


        .search-input:focus {
            border-color: #1976d2;
            box-shadow: 0 0 0 3px rgba(25,118,210,0.1);
        }


    /* =========================
       SEARCH BUTTON
       ========================= */

    .search-btn {
        height: 48px;
        padding: 0 30px;
        border: none;
        border-radius: 7px;
        background: #1976d2;
        color: white;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
    }


        .search-btn:hover {
            background: #125ca8;
        }


    /* =========================
       SECTION HEADING
       ========================= */

    .section-heading {
        margin-bottom: 20px;
    }


        .section-heading h2 {
            margin: 0;
            color: #172b4d;
            font-size: 25px;
        }


        .section-heading p {
            margin-top: 5px;
            color: #7a8795;
        }


    /* =========================
       JOB GRID
       ========================= */

    .job-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
    }


    /* =========================
       JOB CARD
       ========================= */

    .job-card {
        background: white;
        border: 1px solid #e1e6eb;
        border-radius: 12px;
        padding: 22px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.06);
        transition: all 0.25s ease;
    }


        .job-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 22px rgba(0,0,0,0.12);
            border-color: #c7dff7;
        }


    /* =========================
       COMPANY SECTION
       ========================= */

    .company-section {
        display: flex;
        align-items: center;
        gap: 15px;
        background: #f5f9ff;
        border-left: 5px solid #1976d2;
        padding: 15px 18px;
        margin-bottom: 20px;
        border-radius: 6px;
    }


    /* =========================
       COMPANY LOGO
       ========================= */

    .company-logo-box {
        width: 65px;
        height: 65px;
        background: white;
        border: 1px solid #dce3ea;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        overflow: hidden;
    }


    .company-logo {
        width: 55px;
        height: 55px;
        object-fit: contain;
    }


    /* =========================
       COMPANY INFORMATION
       ========================= */

    .company-info {
        flex: 1;
    }


    .company-label {
        display: block;
        color: #7b8794;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
        margin-bottom: 6px;
    }


    .company-name {
        margin: 0;
        color: #0066cc;
        font-size: 22px;
        font-weight: 700;
        line-height: 1.3;
    }


        .company-name:hover {
            color: #004c99;
        }


    /* =========================
       JOB HEADER
       ========================= */

    .job-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
    }


    .job-title-section {
        flex: 1;
    }


    .job-header h2 {
        margin: 0;
        color: #172b4d;
        font-size: 19px;
        line-height: 1.4;
        font-weight: 600;
    }


    /* =========================
       LOCATION
       ========================= */

    .job-location {
        color: #66788a;
        font-size: 13px;
        white-space: nowrap;
        background: #f7f8fa;
        padding: 6px 9px;
        border-radius: 5px;
    }


    /* =========================
       JOB DETAILS
       ========================= */

    .job-details {
        margin-top: 20px;
        display: flex;
        gap: 12px;
    }


    .detail-item {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #f8f9fb;
        padding: 10px 12px;
        border-radius: 7px;
        flex: 1;
    }


    .detail-icon {
        font-size: 18px;
    }


    .detail-item small {
        display: block;
        color: #8995a3;
        font-size: 11px;
        margin-bottom: 2px;
    }

    .all-jobs-btn {
        display: inline-block;
        padding: 12px 25px;
        text-decoration: none;
        border-radius: 5px;
        cursor: pointer;
    }
    .detail-item strong {
        display: block;
        color: #37475a;
        font-size: 13px;
    }


    /* =========================
       FOOTER
       ========================= */

    .job-footer {
        border-top: 1px solid #edf0f3;
        margin-top: 20px;
        padding-top: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }


    .date-info {
        display: flex;
        gap: 18px;
    }


        .date-info small {
            display: block;
            color: #929da8;
            font-size: 10px;
            margin-bottom: 3px;
        }


        .date-info span {
            color: #596979;
            font-size: 12px;
        }


        .date-info .closing {
            color: #d9534f;
            font-weight: 600;
        }


    /* =========================
       APPLY BUTTON
       ========================= */

    .apply-btn {
        padding: 10px 16px;
        background: #1976d2;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
    }


        .apply-btn:hover {
            background: #125ca8;
        }


    /* =========================
       MOBILE
       ========================= */

    @@media (max-width: 768px) {

        .container {
            width: 94%;
        }

        .job-search {
            padding: 25px 20px;
        }

        .search-heading h1 {
            font-size: 26px;
        }

        .job-grid {
            grid-template-columns: 1fr;
        }

        .search-row {
            flex-direction: column;
        }

        .search-input,
        .search-btn {
            width: 100%;
        }

        .job-header {
            flex-direction: column;
        }

        .job-location {
            white-space: normal;
        }

        .job-details {
            flex-direction: column;
        }

        .job-footer {
            flex-direction: column;
            align-items: flex-start;
        }

        .date-info {
            width: 100%;
            justify-content: space-between;
        }

        .apply-btn {
            width: 100%;
        }

        .company-name {
            font-size: 19px;
        }
    }
</style>
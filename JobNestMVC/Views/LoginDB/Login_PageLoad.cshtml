@model JobNestMVC.Models.LoginCls
@{
    ViewBag.Title = "Login_PageLoad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .login-page {
        min-height: 82vh;
        padding: 50px 20px;
        background: linear-gradient(135deg, #f5f7fb, #eaf0ff);
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .login-card {
        width: 100%;
        max-width: 420px;
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.10);
    }

    .login-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .login-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 15px;
        background: #eef2ff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
    }

    .login-header h2 {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #1f2937;
    }

    .login-header p {
        margin-top: 8px;
        color: #6b7280;
        font-size: 14px;
    }

    .login-form > div {
        margin-bottom: 20px;
    }

    .login-form label {
        display: block;
        margin-bottom: 8px;
        color: #374151;
        font-size: 14px;
        font-weight: 600;
    }

    .login-form input[type="text"] {
        width: 100%;
        box-sizing: border-box;
        padding: 13px 14px;
        border: 1px solid #d1d5db;
        border-radius: 9px;
        font-size: 15px;
        outline: none;
        transition: 0.3s;
    }

        .login-form input[type="text"]:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
        }

    .login-button {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 9px;
        background: #2563eb;
        color: white;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
    }

        .login-button:hover {
            background: #1d4ed8;
            transform: translateY(-2px);
        }

    .login-message {
        display: block;
        text-align: center;
        margin-top: 12px;
        color: #dc2626;
        font-weight: 600;
    }

    .login-footer {
        text-align: center;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #e5e7eb;
        color: #9ca3af;
        font-size: 12px;
    }

    .field-validation-error {
        display: block;
        margin-top: 5px;
        color: #dc2626;
        font-size: 12px;
    }

    @@media (max-width: 500px) {
        .login-card {
            padding: 30px 22px;
        }
    }
</style>

<div class="login-page">

    ```
    <div class="login-card">

        <div class="login-header">

            <div class="login-icon">
                🔐
            </div>

            <h2>Welcome Back</h2>

            <p>Login to your JobNest account</p>

        </div>

        <div>
            @using (Html.BeginForm("Login_Click", "LoginDB", FormMethod.Post))
            {
                <div class="login-form">

                    <div>
                        <label>Username: </label>

                        @Html.TextBoxFor(m => m.Uname)

                        @Html.ValidationMessageFor(m => m.Uname)
                    </div>

                    <div>
                        <label>Password: </label>

                        @Html.TextBoxFor(m => m.password)

                        @Html.ValidationMessageFor(m => m.password)
                    </div>

                    <div>

                        <input type="submit"
                               value="Login"
                               class="login-button" />

                        <span class="login-message">
                            @Html.DisplayFor(m => m.msg)
                        </span>

                    </div>

                </div>

                <div class="login-footer">
                    🔒 Your account information is protected
                </div>
            }
        </div>

    </div>
    ```

</div>
